{"chunk": "<!-- wp:html -->\n<style>\n\n.breadcrumbs, .breadcrumb, .woocommerce-breadcrumb, .rank-math-breadcrumb, .yoast-breadcrumb,\n.entry-header, .page-title-section { display: none !important; }\n#primary, .site-main, .site-content, #content, .content-area {\n  padding-top: 0 !important; margin-top: 0 !important;\n}\n#sidebar, .sidebar, #secondary, .et_pb_column_1_4 { display: none !important; }\n.otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page .entry-content {\n  max-width: none !important; width: 100% !important; padding: 0 !important;\n}\n.otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page .l24-longread-wrap {\n  max-width: 820px; margin: 0 auto; padding: 48px 24px 80px;\n  font-size: 1.05rem; line-height: 1.65; color: #1a202c;\n}\n.otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page h2 {\n  margin-top: 2.5em; color: #1a365d; font-size: 1.45rem;\n}\n.otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page h3 {\n  margin-top: 1.5em; color: #2c5282; font-size: 1.15rem;\n}\n.otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page table {\n  width: 100%; border-collapse: collapse; margin: 1.5em 0; font-size: 0.95rem;\n}\n.otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page th, .otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page td {\n  border: 1px solid #e2e8f0; padding: 10px 12px; text-align: left;\n}\n.otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page th { background: #edf2f7; }\n.otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page a { color: #1e40af; }\n.otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page ol, .otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page ul { margin: 1em 0; padding-left: 1.4em; }\n.otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page li { margin-bottom: 0.45em; }\n.l24-intro-ip-pret {\n  max-width: 1200px; margin: 0 auto; padding: 40px 24px 8px;\n  font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n}\n.l24-intro-ip-pret__grid {\n  display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);\n  gap: 28px; align-items: start;\n}\n.l24-intro-ip-pret__text {\n  border-left: 4px solid #a31830; padding: 4px 0 4px 22px; text-align: left;\n}\n.l24-intro-ip-pret__text p { margin: 0 0 14px; font-size: 1.02rem; line-height: 1.6; color: #334155; }\n.l24-intro-ip-pret__text p:last-child { margin-bottom: 0; }\n.l24-intro-ip-pret__brief {\n  background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;\n  padding: 16px 18px; margin-top: 16px; font-size: 0.95rem; line-height: 1.55;\n}\n.l24-intro-ip-pret__decor {\n  background: linear-gradient(160deg, #f1f5f9 0%, #fff 100%);\n  border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px;\n}\n.l24-intro-ip-pret__chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; padding: 0; list-style: none; }\n.l24-intro-ip-pret__chip {\n  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.03em;\n  padding: 6px 10px; border-radius: 999px; background: #fff;\n  border: 1px solid #cbd5e1; color: #475569;\n}\n.l24-intro-ip-pret__chip--accent { border-color: #1e40af; color: #1e40af; }\n.l24-intro-ip-pret__chip--warn { border-color: #a31830; color: #a31830; }\n.l24-intro-ip-pret__route-svg { display: block; width: 100%; height: auto; }\n.ym-toc {\n  max-width: 820px; margin: 24px auto 0; padding: 0 24px 32px;\n  text-align: center; font-family: system-ui, sans-serif;\n}\n.ym-toc__title { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em;\n  text-transform: uppercase; color: #64748b; margin: 0 0 12px;\n}\n.ym-toc__list { list-style: none; padding: 0; margin: 0;\n  display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 10px;\n}\n.ym-toc__list a {\n  display: inline-block; padding: 8px 12px; border-radius: 8px;\n  background: #f1f5f9; color: #1e40af; text-decoration: none; font-size: 0.88rem; font-weight: 600;\n}\n.ym-toc__list a:hover { background: #e2e8f0; }\n.ym-cta {\n  margin: 28px 0; padding: 22px 24px; border-radius: 10px;\n  background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);\n  border: 1px solid #cbd5e1; border-left: 4px solid #a31830;\n}\n.ym-cta--legis24 { border-left-color: #1e3a8a; background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%); }\n.ym-cta__text { margin: 0 0 14px; line-height: 1.55; color: #334155; }\n.ym-cta__actions { margin: 0; }\n.ym-cta__btn {\n  display: inline-block; background: #a31830; color: #fff !important;\n  padding: 12px 22px; border-radius: 8px; font-weight: 700; text-decoration: none;\n}\n.ym-cta__btn:hover { background: #8b1528; }\n.l24-faq-ip-pret {\n  margin-top: 2.5em; padding: 28px 24px; background: #f8fafc;\n  border: 1px solid #e2e8f0; border-radius: 12px;\n}\n.l24-faq-ip-pret h2 { margin-top: 0 !important; }\n.l24-faq-ip-pret__item { margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid #e2e8f0; }\n.l24-faq-ip-pret__item:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }\n.l24-faq-ip-pret__q { margin: 0 0 8px; font-size: 1.05rem; color: #1a365d; }\n.l24-faq-ip-pret__a { margin: 0; color: #334155; }\n@media (max-width: 900px) {\n  .l24-intro-ip-pret__grid { grid-template-columns: 1fr; }\n}\n\n</style>\n<main id=\"primary\" class=\"site-main otvet-na-pretensiyu-po-intellektualnoj-sobstvennosti-page\" role=\"main\" tabindex=\"-1\" itemscope itemtype=\"https://schema.org/Article\">\n<section id=\"l24-hero-ip-pret-otvet\" class=\"hero-ip-pret-otvet\" aria-label=\"Ответ на претензию по интеллектуальной собственности\">\n  <style>\n    .hero-ip-pret-otvet {\n      position: relative;\n      min-height: 100vh;\n      min-height: 100dvh;\n      box-sizing: border-box;\n      display: flex;\n      align-items: center;\n      padding: 120px 24px 80px;\n      background: linear-gradient(158deg, #fafbfc 0%, #f4f6f9 40%, #eef1f6 100%);\n      color: #0f172a;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n      overflow: hidden;\n    }\n    .hero-ip-pret-otvet::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background:\n        radial-gradient(ellipse 62% 48% at 88% 18%, rgba(30, 64, 175, 0.08) 0%, transparent 58%),\n        radial-gradient(ellipse 48% 42% at 8% 88%, rgba(163, 24, 48, 0.05) 0%, transparent 52%);\n      pointer-events: none;\n    }\n    .hero-ip-pret-otvet__inner {\n      position: relative;\n      z-index: 1;\n      max-width: 1200px;\n      margin: 0 auto;\n      width: 100%;\n      display: grid;\n      grid-template-columns: 1.05fr 0.95fr;\n      gap: 48px;\n      align-items: center;\n    }\n    .hero-ip-pret-otvet__badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      margin: 0 0 18px;\n      padding: 8px 14px;\n      border-radius: 999px;\n      background: rgba(255, 255, 255, 0.92);\n      border: 1px solid rgba(15, 23, 42, 0.1);\n      font-size: 0.82rem;\n      font-weight: 600;\n      letter-spacing: 0.02em;\n      color: #334155;\n    }\n    .hero-ip-pret-otvet__badge-dot {\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: #1e40af;\n      flex-shrink: 0;\n    }\n    .hero-ip-pret-otvet__h1 {\n      margin: 0 0 18px;\n      font-size: clamp(1.55rem, 3.6vw, 2.35rem);\n      line-height: 1.2;\n      font-weight: 800;\n      color: #0f172a;\n      letter-spacing: -0.02em;\n    }\n    .hero-ip-pret-otvet__h1-accent {\n      color: #1e40af;\n    }\n    .hero-ip-pret-otvet__sub {\n      margin: 0 0 28px;\n      max-width: 38em;\n      font-size: clamp(1rem, 1.6vw, 1.12rem);\n      line-height: 1.55;\n      color: #475569;\n    }\n    .hero-ip-pret-otvet__deadlines {\n      list-style: none;\n      padding: 0;\n      margin: 0 0 32px;\n    }\n    .hero-ip-pret-otvet__deadline {\n      display: flex;\n      gap: 14px;\n      align-items: flex-start;\n      margin-bottom: 14px;\n      font-size: 0.94rem;\n      line-height: 1.45;\n      color: #334155;\n    }\n    .hero-ip-pret-otvet__deadline-tag {\n      flex-shrink: 0;\n      min-width: 72px;\n      padding: 6px 10px;\n      border-radius: 6px;\n      font-weight: 700;\n      font-size: 0.72rem;\n      letter-spacing: 0.03em;\n      text-align: center;\n      text-transform: uppercase;\n    }\n    .hero-ip-pret-otvet__deadline--soft .hero-ip-pret-otvet__deadline-tag {\n      background: #f1f5f9;\n      color: #64748b;\n      border: 1px solid #e2e8f0;\n    }\n    .hero-ip-pret-otvet__deadline--key .hero-ip-pret-otvet__deadline-tag {\n      background: #1e40af;\n      color: #fff;\n    }\n    .hero-ip-pret-otvet__deadline--spec .hero-ip-pret-otvet__deadline-tag {\n      background: #0f766e;\n      color: #fff;\n    }\n    .hero-ip-pret-otvet__cta {\n      display: inline-block;\n      background: #a31830;\n      color: #fff !important;\n      padding: 14px 28px;\n      border-radius: 8px;\n      font-weight: 700;\n      font-size: 0.95rem;\n      text-decoration: none;\n      box-shadow: 0 4px 14px rgba(163, 24, 48, 0.22);\n      line-height: 1.35;\n    }\n    .hero-ip-pret-otvet__cta:hover {\n      background: #8b1528;\n    }\n    .hero-ip-pret-otvet__visual {\n      display: flex;\n      justify-content: center;\n      align-items: center;\n    }\n    @media (max-width: 900px) {\n      .hero-ip-pret-otvet__inner {\n        grid-template-columns: 1fr;\n        gap: 32px;\n      }\n      .hero-ip-pret-otvet__visual {\n        order: -1;\n        max-height: 300px;\n      }\n      .hero-ip-pret-otvet__deadline-tag {\n        min-width: 64px;\n        font-size: 0.68rem;\n      }\n    }\n  </style>\n  <div class=\"hero-ip-pret-otvet__inner\">\n    <div class=\"hero-ip-pret-otvet__content\">\n      <div class=\"hero-ip-pret-otvet__badge\">\n        <span class=\"hero-ip-pret-otvet__badge-dot\" aria-hidden=\"true\"></span>\n        ИС · претензия · ст. 1252 · 214-ФЗ · 2026\n      </div>\n      <h1 class=\"hero-ip-pret-otvet__h1\">\n        <span class=\"hero-ip-pret-otvet__h1-accent\">Ответ на претензию</span> по интеллектуальной собственности: сроки и типовые ошибки\n      </h1>\n      <p class=\"hero-ip-pret-otvet__sub\">\n        Сроки досудебного порядка, типичные ошибки ответчика и доказательства до иска по товарному знаку и авторским правам\n      </p>\n      <ul class=\"hero-ip-pret-otvet__deadlines\">\n        <li class=\"hero-ip-pret-otvet__deadline hero-ip-pret-otvet__deadline--soft\">\n          <span class=\"hero-ip-pret-otvet__deadline-tag\">7–14 дн.</span>\n          <span><strong>Срок «из шапки»</strong> — психологическое давление; пропуск не ухудшает позицию автоматически</span>\n        </li>\n        <li class=\"hero-ip-pret-otvet__deadline hero-ip-pret-otvet__deadline--key\">\n          <span class=\"hero-ip-pret-otvet__deadline-tag\">30 дн.</span>\n          <span><strong>п. 5.1 ст. 1252 ГК РФ</strong> — окно для мотивированного ответа до иска о comp/убытках в арбитраже</span>\n        </li>\n        <li class=\"hero-ip-pret-otvet__deadline hero-ip-pret-otvet__deadline--spec\">\n          <span class=\"hero-ip-pret-otvet__deadline-tag\">2 мес.</span>\n          <span><strong>ст. 1486 ГК РФ</strong> — спецрежим по неиспользованию ТЗ; иные сроки и последствия</span>\n        </li>\n      </ul>\n      <a class=\"hero-ip-pret-otvet__cta\" href=\"https://advokat-vsem.ru/\" target=\"_blank\" rel=\"noopener noreferrer\">Консультация по ответу на претензию по ИС</a>\n    </div>\n    <div class=\"hero-ip-pret-otvet__visual\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 440 400\" xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" style=\"max-width:440px\" role=\"img\" aria-label=\"Претензия, ответ с печатью и щит защиты интеллектуальной собственности\">\n        <defs>\n          <linearGradient id=\"hero-pret-paper\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#ffffff\"/>\n            <stop offset=\"100%\" stop-color=\"#f1f5f9\"/>\n          </linearGradient>\n          <linearGradient id=\"hero-pret-shield\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#1e3a8a\"/>\n            <stop offset=\"55%\" stop-color=\"#1e40af\"/>\n            <stop offset=\"100%\" stop-color=\"#2563eb\"/>\n          </linearGradient>\n          <linearGradient id=\"hero-pret-stamp\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#b91c1c\"/>\n            <stop offset=\"100%\" stop-color=\"#a31830\"/>\n          </linearGradient>\n          <linearGradient id=\"hero-pret-desk\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#e7e5e4\"/>\n            <stop offset=\"100%\" stop-color=\"#d6d3d1\"/>\n          </linearGradient>\n          <filter id=\"hero-pret-shadow\" x=\"-12%\" y=\"-12%\" width=\"124%\" height=\"124%\">\n            <feDropShadow dx=\"0\" dy=\"7\" stdDeviation=\"9\" flood-color=\"#0f172a\" flood-opacity=\"0.14\"/>\n          </filter>\n        </defs>\n        <!-- фоновые линии канцелярии -->\n        <g opacity=\"0.28\" stroke=\"#94a3b8\" stroke-width=\"0.7\">\n          <line x1=\"30\" y1=\"72\" x2=\"410\" y2=\"72\"/>\n          <line x1=\"30\" y1=\"112\" x2=\"410\" y2=\"112\"/>\n          <line x1=\"30\" y1=\"152\" x2=\"410\" y2=\"152\"/>\n          <line x1=\"30\" y1=\"192\" x2=\"410\" y2=\"192\"/>\n          <line x1=\"30\" y1=\"232\" x2=\"410\" y2=\"232\"/>\n          <line x1=\"30\" y1=\"272\" x2=\"410\" y2=\"272\"/>\n          <line x1=\"30\" y1=\"312\" x2=\"410\" y2=\"312\"/>\n        </g>\n        <!-- щит ИС (задний план) -->\n        <g filter=\"url(#hero-pret-shadow)\" transform=\"translate(148, 58)\">\n          <path d=\"M72 0 L144 28 V88 C144 128 108 158 72 172 C36 158 0 128 0 88 V28 Z\" fill=\"url(#hero-pret-shield)\" stroke=\"#1e3a8a\" stroke-width=\"2\"/>\n          <circle cx=\"72\" cy=\"78\" r=\"34\" fill=\"rgba(255,255,255,0.12)\" stroke=\"rgba(255,255,255,0.35)\" stroke-width=\"1.5\"/>\n          <text x=\"72\" y=\"72\" text-anchor=\"middle\" fi