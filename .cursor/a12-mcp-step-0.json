 stroke-linecap=\"round\"/>\n          <line x1=\"18\" y1=\"162\" x2=\"108\" y2=\"162\" stroke=\"#e2e8f0\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n        </g>\n        <!-- исходящий ответ -->\n        <g filter=\"url(#hero-pret-shadow)\" transform=\"translate(248, 108) rotate(4 70 95)\">\n          <rect width=\"148\" height=\"188\" rx=\"8\" fill=\"url(#hero-pret-paper)\" stroke=\"#93c5fd\" stroke-width=\"1.6\"/>\n          <rect x=\"0\" y=\"0\" width=\"148\" height=\"34\" rx=\"8\" fill=\"#eff6ff\"/>\n          <rect x=\"0\" y=\"26\" width=\"148\" height=\"8\" fill=\"#eff6ff\"/>\n          <text x=\"74\" y=\"22\" text-anchor=\"middle\" fill=\"#1e40af\" font-size=\"10\" font-weight=\"800\" letter-spacing=\"0.06em\">ОТВЕТ</text>\n          <line x1=\"20\" y1=\"50\" x2=\"128\" y2=\"50\" stroke=\"#dbeafe\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n          <line x1=\"20\" y1=\"66\" x2=\"116\" y2=\"66\" stroke=\"#dbeafe\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n          <line x1=\"20\" y1=\"80\" x2=\"124\" y2=\"80\" stroke=\"#dbeafe\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n          <line x1=\"20\" y1=\"94\" x2=\"100\" y2=\"94\" stroke=\"#dbeafe\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n          <rect x=\"20\" y=\"110\" width=\"108\" height=\"24\" rx=\"4\" fill=\"#ecfdf5\" stroke=\"#a7f3d0\" stroke-width=\"1\"/>\n          <text x=\"74\" y=\"126\" text-anchor=\"middle\" fill=\"#047857\" font-size=\"8.5\" font-weight=\"700\">по пунктам · без признаний</text>\n          <line x1=\"20\" y1=\"150\" x2=\"128\" y2=\"150\" stroke=\"#dbeafe\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n          <line x1=\"20\" y1=\"164\" x2=\"112\" y2=\"164\" stroke=\"#dbeafe\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n        </g>\n        <!-- печать на ответе -->\n        <g filter=\"url(#hero-pret-shadow)\" transform=\"translate(318, 248) rotate(12)\">\n          <circle cx=\"0\" cy=\"0\" r=\"34\" fill=\"none\" stroke=\"url(#hero-pret-stamp)\" stroke-width=\"3.5\" opacity=\"0.92\"/>\n          <circle cx=\"0\" cy=\"0\" r=\"26\" fill=\"none\" stroke=\"url(#hero-pret-stamp)\" stroke-width=\"1.5\" opacity=\"0.75\"/>\n          <text x=\"0\" y=\"-4\" text-anchor=\"middle\" fill=\"#a31830\" font-size=\"8\" font-weight=\"800\" letter-spacing=\"0.1em\">ОТВЕТ</text>\n          <text x=\"0\" y=\"10\" text-anchor=\"middle\" fill=\"#a31830\" font-size=\"7\" font-weight=\"700\">НАПРАВЛЕН</text>\n        </g>\n        <!-- стрелка претензия → ответ -->\n        <g stroke=\"#64748b\" stroke-width=\"2\" fill=\"none\" opacity=\"0.55\">\n          <path d=\"M178 210 C210 200, 230 198, 252 205\" stroke-dasharray=\"5 4\"/>\n          <polygon points=\"252,205 244,200 246,210\" fill=\"#64748b\" stroke=\"none\"/>\n        </g>\n        <!-- календарь 30 дней -->\n        <g filter=\"url(#hero-pret-shadow)\" transform=\"translate(52, 28)\">\n          <rect width=\"108\" height=\"72\" rx=\"10\" fill=\"#fff\" stroke=\"#cbd5e1\" stroke-width=\"1.2\"/>\n          <rect x=\"0\" y=\"0\" width=\"108\" height=\"22\" rx=\"10\" fill=\"#1e40af\"/>\n          <rect x=\"0\" y=\"14\" wi", "reset": true}