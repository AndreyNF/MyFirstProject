: #fff !important;\n  padding: 12px 22px; border-radius: 8px; font-weight: 700; text-decoration: none;\n}\n.ym-cta__btn:hover { background: #8b1528; }\n.l24-faq-a9 {\n  margin-top: 2.5em; padding: 28px 24px; background: #f8fafc;\n  border: 1px solid #e2e8f0; border-radius: 12px;\n}\n.l24-faq-a9 h2 { margin-top: 0 !important; }\n.l24-faq-a9__item { margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid #e2e8f0; }\n.l24-faq-a9__item:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }\n.l24-faq-a9__q { margin: 0 0 8px; font-size: 1.05rem; color: #1a365d; }\n.l24-faq-a9__a { margin: 0; color: #334155; }\n.l24-jsonld-note {\n  display: none; /* JSON-LD для Rank Math — см. блок Передача Юре */\n}\n@media (max-width: 900px) {\n  .l24-intro-a9__grid { grid-template-columns: 1fr; }\n}\n\n</style>\n<main id=\"primary\" class=\"site-main narushenie-tovarnogo-znaka-dokazatelstva-kompensaciya-page\" role=\"main\" tabindex=\"-1\" itemscope itemtype=\"https://schema.org/Article\">\n<section id=\"l24-hero-ip-tz-nar\" class=\"hero-ip-tz-nar\" aria-label=\"Защита товарного знака и бренда\">\n  <style>\n    .hero-ip-tz-nar {\n      position: relative;\n      min-height: 100vh;\n      min-height: 100dvh;\n      box-sizing: border-box;\n      display: flex;\n      align-items: center;\n      padding: 120px 24px 80px;\n      background: linear-gradient(165deg, #f8fafc 0%, #eef2f7 42%, #f5f0eb 100%);\n      color: #1a2332;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n      overflow: hidden;\n    }\n    .hero-ip-tz-nar::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background:\n        radial-gradient(ellipse 70% 50% at 85% 20%, rgba(30, 64, 175, 0.07) 0%, transparent 55%),\n        radial-gradient(ellipse 50% 40% at 10% 80%, rgba(163, 24, 48, 0.05) 0%, transparent 50%);\n      pointer-events: none;\n    }\n    .hero-ip-tz-nar__inner {\n      position: relative;\n      z-index: 1;\n      max-width: 1200px;\n      margin: 0 auto;\n      width: 100%;\n      display: grid;\n      grid-template-columns: 1.05fr 0.95fr;\n      gap: 48px;\n      align-items: center;\n    }\n    .hero-ip-tz-nar__badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      margin: 0 0 18px;\n      padding: 8px 14px;\n      border-radius: 999px;\n      background: rgba(255, 255, 255, 0.85);\n      border: 1px solid rgba(26, 35, 50, 0.1);\n      font-size: 0.82rem;\n      font-weight: 600;\n      letter-spacing: 0.02em;\n      color: #334155;\n    }\n    .hero-ip-tz-nar__badge-dot {\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: #1e40af;\n      flex-shrink: 0;\n    }\n    .hero-ip-tz-nar__h1 {\n      margin: 0 0 18px;\n      font-size: clamp(1.65rem, 3.8vw, 2.45rem);\n      line-height: 1.18;\n      font-weight: 800;\n      color: #0f172a;\n      letter-spacing: -0.02em;\n    }\n    .hero-ip-tz-nar__h1-accent {\n      color: #1e40af;\n    }\n    .hero-ip-tz-nar__sub {\n      margin: 0 0 28px;\n      max-width: 38em;\n      font-size: clamp(1rem, 1.6vw, 1.12rem);\n      line-height: 1.55;\n      color: #475569;\n    }\n    .hero-ip-tz-nar__steps {\n      list-style: none;\n      padding: 0;\n      margin: 0 0 32px;\n    }\n    .hero-ip-tz-nar__step {\n      display: flex;\n      gap: 14px;\n      align-items: flex-start;\n      margin-bottom: 14px;\n      font-size: 0.94rem;\n      line-height: 1.45;\n      color: #334155;\n    }\n    .hero-ip-tz-nar__step-num {\n      flex-shrink: 0;\n      width: 30px;\n      height: 30px;\n      border-radius: 50%;\n      background: #1e40af;\n      color: #fff;\n      font-weight: 700;\n      font-size: 0.82rem;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .hero-ip-tz-nar__cta {\n      display: inline-block;\n      background: #a31830;\n      color: #fff !important;\n      padding: 14px 28px;\n      border-radius: 8px;\n      font-weight: 700;\n      font-size: 0.95rem;\n      text-decoration: none;\n      box-shadow: 0 4px 14px rgba(163, 24, 48, 0.22);\n    }\n    .hero-ip-tz-nar__cta:hover {\n      background: #8b1528;\n    }\n    .hero-ip-tz-nar__visual {\n      display: flex;\n      justify-content: center;\n      align-items: center;\n    }\n    @media (max-width: 900px) {\n      .hero-ip-tz-nar__inner {\n        grid-template-columns: 1fr;\n        gap: 32px;\n      }\n      .hero-ip-tz-nar__visual {\n        order: -1;\n        max-height: 280px;\n      }\n    }\n  </style>\n  <div class=\"hero-ip-tz-nar__inner\">\n    <div class=\"hero-ip-tz-nar__content\">\n      <div class=\"hero-ip-tz-nar__badge\">\n        <span class=\"hero-ip-tz-nar__badge-dot\" aria-hidden=\"true\"></span>\n        ИС · товарный знак · ГК РФ ч. 4 · 2026\n      </div>\n      <h1 class=\"hero-ip-tz-nar__h1\">\n        <span class=\"hero-ip-tz-nar__h1-accent\">Товарный знак:</span> как защитить бренд и что делать, если подали иск\n      </h1>\n      <p class=\"hero-ip-tz-nar__sub\">\n        Нарушение прав, претензия и иск по товарному знаку: судебная защита, компенсация и ответ на требования правообладателя\n      </p>\n      <ol class=\"hero-ip-tz-nar__steps\">\n        <li class=\"hero-ip-tz-nar__step\">\n          <span class=\"hero-ip-tz-nar__step-num\">1</span>\n          <span><strong>Реестр и бренд</strong> — регистрация в Роспатенте, проверка коллизий, класс 35 МКТУ</span>\n        </li>\n        <li class=\"hero-ip-tz-nar__step\">\n          <span class=\"hero-ip-tz-nar__step-num\">2</span>\n          <span><strong>Претензия 30 дней</strong> — досудебный ответ до иска, маркетплейс и расчёт компенсации</span>\n        </li>\n        <li class=\"hero-ip-tz-nar__step\">\n          <span class=\"hero-ip-tz-nar__step-num\">3</span>\n          <span><strong>Иск и защита</strong> — отзыв по ст. 131 АПК, ст. 1486 и снижение по ст. 1252.1</span>\n        </li>\n      </ol>\n      <a class=\"hero-ip-tz-nar__cta\" href=\"https://advokat-vsem.ru/\" target=\"_blank\" rel=\"noopener noreferrer\">Консультация по защите бренда и ответу на иск</a>\n    </div>\n    <div class=\"hero-ip-tz-nar__visual\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 420 380\" xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" style=\"max-width:420px\" role=\"img\" aria-label=\"Щит, товарный знак и правовая защита бренда\">\n        <defs>\n          <linearGradient id=\"hero-tz-shield\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#1e40af\"/>\n            <stop offset=\"100%\" stop-color=\"#3b82f6\"/>\n          </linearGradient>\n          <linearGradient id=\"hero-tz-card\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#ffffff\"/>\n            <stop offset=\"100%\" stop-color=\"#f1f5f9\"/>\n          </linearGradient>\n          <filter id=\"hero-tz-shadow\" x=\"-10%\" y=\"-10%\" width=\"120%\" height=\"120%\">\n            <feDropShadow dx=\"0\" dy=\"6\" stdDeviation=\"10\" flood-color=\"#1e293b\" flood-opacity=\"0.12\"/>\n          </filter>\n        </defs>\n        <!-- фоновая сетка реестра -->\n        <g opacity=\"0.35\" stroke=\"#94a3b8\" stroke-width=\"0.6\">\n          <line x1=\"40\" y1=\"60\" x2=\"380\" y2=\"60\"/>\n          <line x1=\"40\" y1=\"100\" x2=\"380\" y2=\"100\"/>\n          <line x1=\"40\" y1=\"140\" x2=\"380\" y2=\"140\"/>\n          <line x1=\"40\" y1=\"180\" x2=\"380\" y2=\"180\"/>\n          <line x1=\"80\" y1=\"40\" x2=\"80\" y2=\"340\"/>\n          <line x1=\"160\" y1=\"40\" x2=\"160\" y2=\"340\"/>\n          <line x1=\"240\" y1=\"40\" x2=\"240\" y2=\"340\"/>\n          <line x1=\"320\" y1=\"40\" x2=\"320\" y2=\"340\"/>\n        </g>\n        <!-- карточка бренда -->\n        <g filter=\"url(#hero-tz-shadow)\" transform=\"translate(28, 52)\">\n          <rect width=\"118\" height=\"72\" rx=\"10\" fill=\"url(#hero-tz-card)\" stroke=\"#cbd5e1\" stroke-width=\"1.2\"/>\n          <rect x=\"14\" y=\"16\" width=\"48\" height=\"10\" rx=\"3\" fill=\"#e2e8f0\"/>\n          <rect x=\"14\" y=\"34\" width=\"88\" height=\"8\" rx=\"2\" fill=\"#e2e8f0\"/>\n          <rect x=\"14\" y=\"48\" width=\"64\" height=\"8\" rx=\"2\" fill=\"#e2e8f0\"/>\n          <circle cx=\"96\" cy=\"22\" r=\"14\" fill=\"#fef3c7\" stroke=\"#d97706\" stroke-width=\"1.5\"/>\n          <text x=\"96\" y=\"27\" text-anchor=\"middle\" fill=\"#92400e\" font-size=\"14\" font-weight=\"800\" font-family=\"Georgia, serif\">®</text>\n          <text x=\"59\" y=\"68\" text-anchor=\"middle\" fill=\"#64748b\" f", "reset": true}