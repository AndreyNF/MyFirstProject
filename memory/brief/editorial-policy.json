{
  "policy_id": "legis24-utility-only-v1",
  "allowed_search_intent": [
    "how_to",
    "checklist",
    "comparison",
    "troubleshooting",
    "workflow",
    "parent_guide",
    "informational",
    "transactional",
    "informational + transactional",
    "guide"
  ],
  "rejected_search_intent": [
    "news",
    "opinion",
    "case_study"
  ],
  "allowed_article_mode": ["B", "guide", "checklist", "comparison", "workflow", "deep-dive"],
  "topic_title_must_match": [
    "как",
    "чек",
    "гайд",
    "порядок",
    "срок",
    "обжал",
    "жалоб",
    "что делать",
    "образец",
    "инструк"
  ],
